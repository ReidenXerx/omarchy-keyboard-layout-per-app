#!/usr/bin/python3
"""Per-application keyboard layout: remember what you chose, restore it on focus.

Focus Telegram, switch to Ukrainian, focus the terminal -- it returns to US. Focus Telegram
again and Ukrainian comes back. KDE and Windows do this; Hyprland has a single global
layout, so this supplies the memory.

Apps with no assignment get layout INDEX 0 (first in kb_layout, i.e. US). Assignments are
stored by layout name, as Hyprland reports it, and applied by the index xkbcommon gives
that name in the current kb_layout.

Keyed by window CLASS, so a second window of the same app inherits the choice.

Assignments live in ~/.config/omarchy/kb-layout-per-app.json -- hand-editable, and managed
by `kb-layout-assign`.

Hyprland shapes this in three ways:
  * layout is per DEVICE: a laptop can expose ten keyboards, and an input method (fcitx5)
    adds a virtual one it injects keys through, copying onto it the layout of the keyboard
    it grabbed. Every keyboard is switched in ONE request (kb.switch_all), so the input
    method cannot copy a layout in between and have it advanced twice.
  * applying a layout, a reload compiling the keymap again, and a keyboard being plugged in
    all emit activelayout, exactly like a switch. So events are never taken at their word:
    they only prompt a reading of the seat, and a physical keyboard that has left the index
    this daemon last put the seat on is what counts as a choice (see LayoutMemory.sync).
  * virtual keyboards follow the real ones, so their events and layouts are ignored.

A layer that takes the keyboard -- the Omarchy menu, Omagram's quick reply -- sends no focus
event, so a layout picked in it used to land on the app underneath, and closing it left that
app on the layer's layout. While such a layer is open it is the app, remembered as
"layer:<namespace>" (kb_layout.KEYBOARD_LAYERS), and closing it brings the app's own back.

Every decision goes to ~/.local/state/omalang/decisions.log (kb_layout.DecisionLog): classes,
layer namespaces, keyboards and layout names, never window titles. It is written at most once
a minute, at once on SIGUSR1, and when the daemon stops.

Bounds: the daemon exits with the shell that started it; event frames over
MAX_EVENT_LINE are dropped and the read buffer never holds more than MAX_EVENT_BUFFER;
class and layout names over kb_layout.MAX_NAME characters, or with control characters, are
never stored; at most kb_layout.MAX_APPS apps are remembered.
"""
import os
import select
import signal
import sys
import time

sys.dont_write_bytecode = True  # never write __pycache__ into the plugin directory
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import plugin_safety as safe  # noqa: E402
import kb_layout as kb  # noqa: E402

MAX_EVENT_LINE = 4 * 1024
MAX_EVENT_BUFFER = 64 * 1024
RECV_SIZE = 4096
# How long the socket has to stay quiet after a layout event before the seat is read, and
# the most that reading can be put off by a steady stream of events.
SETTLE_QUIET = 0.04
SETTLE_MAX = 0.25
MAX_TABLES = 8


# ------------------------------------------------------------------ event framing

class LineReader:
    """Newline-framed events with hard limits. A frame longer than max_line is dropped
    whole -- everything up to its newline is skipped -- and the buffer is reset if it ever
    exceeds max_buffer, so the socket can cost at most max_buffer bytes of memory."""

    def __init__(self, max_line=MAX_EVENT_LINE, max_buffer=MAX_EVENT_BUFFER):
        self.max_line, self.max_buffer = max_line, max_buffer
        self.buf = bytearray()
        self.skipping = False
        self.dropped = 0

    def feed(self, chunk):
        lines = []
        self.buf += chunk
        if len(self.buf) > self.max_buffer:
            self.buf.clear()
            self.skipping = True
            self.dropped += 1
            return lines
        start = 0
        while True:
            newline = self.buf.find(b"\n", start)
            if newline < 0:
                break
            line = bytes(self.buf[start:newline])
            start = newline + 1
            if self.skipping:          # the tail of a frame already dropped
                self.skipping = False
                continue
            if len(line) > self.max_line:
                self.dropped += 1
                continue
            lines.append(line)
        del self.buf[:start]
        if len(self.buf) > self.max_line:
            self.buf.clear()
            if not self.skipping:
                self.dropped += 1
            self.skipping = True
        return lines


def parse_event(line):
    """("window", class), ("layout", keyboard), ("reload", ""), ("layer-open", namespace) or
    ("layer-close", namespace) for the events acted on, else None. An activewindow's title and
    an activelayout's layout name are not kept: the seat is read instead. Values are raw;
    LayoutMemory checks them."""
    name, _, payload = line.decode("utf-8", "replace").partition(">>")
    if name == "activewindow":
        return "window", payload.split(",", 1)[0].strip()
    if name in ("openlayer", "closelayer"):
        return ("layer-open" if name == "openlayer" else "layer-close"), payload.strip()
    if name == "activelayout":
        if "," not in payload:
            return None
        return "layout", payload.split(",", 1)[0].strip()
    if name == "configreloaded":
        return "reload", ""
    return None


def parse_events(lines):
    return [event for event in map(parse_event, lines) if event is not None]


# ------------------------------------------------------------------ the seat

class Seat:
    """What LayoutMemory asks of Hyprland and xkbcommon; tests hand it their own."""

    def __init__(self):
        self.tables = {}

    def keyboards(self):
        return kb.seat_keyboards()

    def switch(self, index):
        kb.switch_all(index)

    def active_class(self):
        return kb.active_class()

    def table(self, rmlvo):
        if rmlvo not in self.tables:
            if len(self.tables) >= MAX_TABLES:
                self.tables.clear()
            self.tables[rmlvo] = kb.layout_table(rmlvo)
        return self.tables[rmlvo]


class LayoutMemory:
    """Applies an app's layout when it is focused and records the layout chosen while it is.
    Hyprland and the assignments file are parameters so tests can stand in for them."""

    def __init__(self, seat, load=kb.load_config, save=kb.save_config, notes=None):
        self.seat, self.load, self.save = seat, load, save
        self.notes = notes or kb.NoDecisions()
        self.cls = None
        self.layers = []            # open layers that take the keyboard, newest last
        self.under = None           # the app they opened over
        self.expected = None        # the layout index this daemon last put the seat on
        self.rmlvo, self.names = None, []
        self.known = set()          # (name, address) of the physical keyboards last read
        self.changed = None         # physical keyboard named by a layout event not yet read
        self.reloaded = False

    # -- reading the seat

    def read(self):
        """(keyboards, remapped, added) or None when Hyprland could not be asked. remapped:
        the keymap is not the one last read; added: physical keyboards not there last time
        (a new address, so one plugged back in after suspend counts too)."""
        keyboards = self.seat.keyboards()
        if keyboards is None:
            return None
        rmlvo, names = kb.seat_names(keyboards, self.seat.table)
        remapped = self.rmlvo is not None and rmlvo != self.rmlvo
        self.rmlvo, self.names = rmlvo, names
        seen = {(k["name"], k.get("address")) for k in kb.physical_keyboards(keyboards)}
        added = {name for name, _ in seen - self.known} if self.known else set()
        self.known = seen
        return keyboards, remapped, added

    def index_for(self, cls):
        """Where cls's assigned layout sits in kb_layout; 0 when it has none, or names one
        kb_layout no longer carries."""
        want = self.load()[0].get(cls)
        if want and want in self.names:
            return self.names.index(want)
        if want:
            kb.log(f"{cls} is assigned {want!r}, which kb_layout does not have; using the first layout")
            self.notes.note(f"{cls} is assigned {want}, which kb_layout does not have: the first layout instead")
        return 0

    def name_of(self, index):
        return self.names[index] if index is not None and 0 <= index < len(self.names) else f"layout {index}"

    def settle(self, keyboards, index):
        """Every keyboard onto `index`, in one request, unless all of them already are."""
        self.expected = index
        if any(kb.layout_index(k) != index for k in kb.switchable_keyboards(keyboards)):
            self.seat.switch(index)

    # -- events

    def start(self):
        """Adopt the seat as it is: nothing is applied or recorded until something changes,
        so restarting the shell never moves the layout under your fingers. Keyboards left on
        different layouts (by an older version, or anything switching them one at a time)
        are brought back onto the one most of them are on."""
        self.cls = self.seat.active_class()
        reading = self.read()
        if reading is None:
            self.notes.note("started, but the keyboards could not be read")
            return
        index = kb.seat_index(reading[0])
        self.notes.note(f"started: layouts {', '.join(self.names) or '?'}; {self.cls or 'no window'} focused; "
                        f"keyboards on {self.name_of(index)}")
        if index is not None:
            self.settle(reading[0], index)

    def window(self, cls):
        if self.layers:
            if not cls or cls == self.under:
                # Hyprland drops window focus and hands it back around a layer; while the layer
                # is open it keeps the keyboard, and its close event restores the app.
                return
            self.notes.note(f"focus went to {cls} while {self.layers[-1]} was open: leaving the layer")
            self.layers, self.under = [], None
        if cls and cls == self.cls:
            return
        if not cls:
            # Focus left every window (an empty workspace): no app to restore for, and a
            # switch made now belongs to none. Coming back re-applies the app's layout.
            if self.cls:
                self.notes.note("focus left every window")
            self.cls = None
            return
        if kb.clean_name(cls) is None:
            # A class too long or odd to store can never have an assignment, so it gets what
            # every unassigned app gets -- and nothing is recorded against it.
            kb.log("focused window has an unusable class; using the default layout")
            self.notes.note("focused a window with an unusable class: the first layout, nothing remembered")
            self.cls = None
            self.expected = 0
            self.seat.switch(0)
            return
        self.cls = cls
        if not self.names and self.read() is None:
            self.notes.note(f"focus {cls}: the keyboards could not be read")
            return
        self.expected = self.index_for(cls)
        self.notes.note(f"focus {cls}: {self.name_of(self.expected)}")
        self.seat.switch(self.expected)

    def layer_open(self, namespace):
        app = kb.layer_app(namespace)
        if app is None or (self.layers and self.layers[-1] == app):
            return
        if not self.layers:
            self.under = self.cls
        if app in self.layers:
            self.layers.remove(app)
        self.layers = (self.layers + [app])[-kb.MAX_LAYERS_OPEN:]
        self.cls = app
        if not self.names and self.read() is None:
            self.notes.note(f"{app} opened: the keyboards could not be read")
            return
        self.expected = self.index_for(app)
        self.notes.note(f"{app} opened over {self.under or 'no window'}: {self.name_of(self.expected)}")
        self.seat.switch(self.expected)

    def layer_close(self, namespace):
        app = kb.layer_app(namespace)
        if app is None or app not in self.layers:
            return
        top = self.layers[-1] == app
        self.layers.remove(app)
        if not top:
            return
        self.cls = self.layers[-1] if self.layers else self.under
        if not self.layers:
            self.under = None
        if not self.cls:
            self.notes.note(f"{app} closed: no window to go back to")
            return
        if not self.names and self.read() is None:
            return
        self.expected = self.index_for(self.cls)
        self.notes.note(f"{app} closed: back to {self.cls}, {self.name_of(self.expected)}")
        self.seat.switch(self.expected)

    def layout(self, keyboard):
        if keyboard and not kb.is_virtual(keyboard):
            self.changed = keyboard

    def reload(self):
        self.reloaded = True

    def sync(self):
        """Read the seat once for the layout events and reloads seen since the last read."""
        changed, reloaded = self.changed, self.reloaded
        self.changed, self.reloaded = None, False
        reading = self.read()
        if reading is None:
            self.notes.note("a layout event, but the keyboards could not be read")
            return
        keyboards, remapped, added = reading
        if reloaded or remapped:
            # Compiling the keymap again puts every keyboard back on the first layout and
            # announces it like a switch, and a new kb_layout moves the indices. Nobody chose
            # either: restore the app's layout by name instead of recording one.
            index = self.index_for(self.cls) if self.cls else kb.seat_index(keyboards)
            self.notes.note(f"{'config reloaded' if reloaded else 'keymap changed'}: "
                            f"{self.cls or 'the keyboards'} back on {self.name_of(index)}")
            if index is not None:
                self.settle(keyboards, index)
            return
        current = kb.seat_index(keyboards, named=changed)
        if current is None:
            self.notes.note(f"a layout event from {changed or 'a keyboard'}, but no layout could be read")
            return
        if self.expected is not None and current != self.expected and changed not in added:
            self.notes.note(f"{changed or 'a keyboard'} switched to {self.name_of(current)} in "
                            f"{self.cls or 'no app'} (expected {self.name_of(self.expected)})")
            self.record(current)
        elif self.expected is not None:
            if changed in added and current != self.expected:
                self.notes.note(f"{changed} plugged in: joins {self.name_of(self.expected)}")
            current = self.expected         # a keyboard that just arrived joins the seat
        self.settle(keyboards, current)

    def record(self, index):
        name = self.names[index] if index < len(self.names) else None
        if not self.cls or not name:
            self.notes.note("not remembered: " + ("no app has the keyboard" if not self.cls else "that layout has no name"))
            return
        assignments, writable = self.load()
        if assignments.get(self.cls) == name:
            return
        if not writable:
            kb.log(f"not recording {self.cls}: the assignments file is unusable")
            self.notes.note(f"not remembered for {self.cls}: the assignments file is unusable")
            return
        result = kb.assign(assignments, self.cls, name)
        if result == "full":
            kb.log(f"{kb.MAX_APPS} apps already have a layout; not remembering one for "
                   f"{self.cls} (clear some with kb-layout-assign clear-ui)")
            self.notes.note(f"not remembered for {self.cls}: {kb.MAX_APPS} apps already have a layout")
        elif result == "changed":
            try:
                self.save(assignments)
                self.notes.note(f"remembered {name} for {self.cls}")
            except (safe.UnsafeError, OSError) as e:
                kb.log(f"could not save assignments: {e}")
                self.notes.note(f"could not save {name} for {self.cls}: {e}")

    def handle(self, events):
        """One batch of events, in order. Pending layout events are settled before focus
        moves on, so a switch is recorded for the app it was made in."""
        for position, (kind, value) in enumerate(events):
            if kind in ("window", "layer-open", "layer-close"):
                if kind == "window" and position + 1 < len(events) and events[position + 1][0] == "window":
                    continue                # focus moved on again before this was handled
                if self.changed or self.reloaded:
                    self.sync()
                if kind == "window":
                    self.window(value)
                elif kind == "layer-open":
                    self.layer_open(value)
                else:
                    self.layer_close(value)
            elif kind == "layout":
                self.layout(value)
            elif kind == "reload":
                self.reload()
        if self.changed or self.reloaded:
            self.sync()


# ------------------------------------------------------------------ main loop

def main():
    safe.die_with_parent()
    notes = kb.DecisionLog()
    kb.exit_cleanly_on_signals(before=lambda: notes.flush(force=True))
    flush_now = [False]
    signal.signal(signal.SIGUSR1, lambda signum, frame: flush_now.__setitem__(0, True))
    try:
        sock = kb.connect(".socket2.sock")
    except (safe.UnsafeError, OSError) as e:
        print(f"kb-layout-daemon: {e}", file=sys.stderr)
        return 1
    if sock is None:
        print("kb-layout-daemon: no hyprland event socket", file=sys.stderr)
        return 1
    reader, memory, dropped = LineReader(), LayoutMemory(Seat(), notes=notes), 0
    try:
        return loop(sock, reader, memory, notes, flush_now, dropped)
    finally:
        notes.flush(force=True)


def loop(sock, reader, memory, notes, flush_now, dropped):
    with sock:
        memory.start()
        while True:
            # Awake at least once a second, so a SIGUSR1 or a quiet minute still writes the log.
            if not select.select([sock], [], [], 1.0)[0]:
                notes.flush(force=flush_now[0])
                flush_now[0] = False
                continue
            try:
                chunk = sock.recv(RECV_SIZE)
            except OSError as e:
                print(f"kb-layout-daemon: {e}", file=sys.stderr)
                notes.note(f"the event socket failed: {e}")
                return 1
            if not chunk:
                break
            events = parse_events(reader.feed(chunk))
            if any(kind != "window" for kind, _ in events):
                # A switch announces itself once per keyboard, and a reload announces its
                # keymap resets before configreloaded: read on until the socket is quiet, so
                # one reading of the seat settles all of it.
                deadline = time.monotonic() + SETTLE_MAX
                while time.monotonic() < deadline:
                    if not select.select([sock], [], [], SETTLE_QUIET)[0]:
                        break
                    try:
                        chunk = sock.recv(RECV_SIZE)
                    except OSError:
                        break
                    if not chunk:
                        break               # the next recv sees the end as well
                    events += parse_events(reader.feed(chunk))
            try:
                memory.handle(events)
            except Exception as e:  # noqa: BLE001 - one bad batch must not end per-app layouts
                kb.log(f"handling events failed: {type(e).__name__}: {e}")
                notes.note(f"handling events failed: {type(e).__name__}: {e}")
            if reader.dropped != dropped:
                dropped = reader.dropped
                kb.log(f"dropped {dropped} oversized event frame(s)")
            notes.flush(force=flush_now[0])
            flush_now[0] = False
    return 0


if __name__ == "__main__":
    sys.exit(main())
