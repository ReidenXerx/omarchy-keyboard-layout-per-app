#!/usr/bin/python3
"""Assign a keyboard layout to an application.

  kb-layout-assign                    pick an app, then a layout (native Omarchy menus)
  kb-layout-assign list               show current assignments
  kb-layout-assign set <class> <layout>
  kb-layout-assign clear <class>      back to the default (US)
  kb-layout-assign clear-ui           pick an assignment to clear

For the bar widget -- bounded, machine-readable:

  kb-layout-assign devices            keyboards as JSON (name, layout, active_keymap,
                                      active_layout_index); prints nothing if hyprctl failed
  kb-layout-assign layouts            the brief/description lines of `xkbcli list --load-exotic`
  kb-layout-assign cycle              every keyboard to its next layout, in one request

Assignments are read live by kb-layout-daemon, so changes apply on the next focus --
nothing to restart. The file is plain JSON and safe to hand-edit.
"""
import json
import os
import sys

sys.dont_write_bytecode = True  # never write __pycache__ into the plugin directory
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import plugin_safety as safe  # noqa: E402
import kb_layout as kb  # noqa: E402

DEFAULT_ROW = "Default (US)"


def usage():
    print(__doc__.strip(), file=sys.stderr)
    return 2


def err(message):
    print(f"kb-layout-assign: {message}", file=sys.stderr)


# ------------------------------------------------------------------ widget subcommands

def cmd_devices(args):
    keyboards = kb.seat_keyboards()
    if keyboards is None:
        # Print nothing: an empty list would read as a seat with no keyboards, and the
        # widget would drop its label for a query that merely failed.
        return 1
    sys.stdout.write(json.dumps(kb.widget_keyboards(keyboards), ensure_ascii=False) + "\n")
    return 0


def cmd_layouts(args):
    blob = kb.output_of(["xkbcli", "list", "--load-exotic"],
                        timeout=kb.XKBCLI_TIMEOUT, max_output=kb.XKBCLI_MAX_OUTPUT)
    if blob is None:
        return 1
    sys.stdout.write(kb.layout_listing(blob.decode("utf-8", "replace")) + "\n")
    return 0


def cmd_cycle(args):
    # Widgets older than this helper still name a keyboard; it is checked and ignored,
    # because every keyboard is switched together, in one request (kb.switch_all).
    if len(args) > 1 or (args and not kb.device_name(args[0])):
        return usage()
    return 0 if kb.switch_all("next") else 1


# ------------------------------------------------------------------ assignments

def layout_names():
    """Display names in kb_layout order, as xkbcommon names the seat's keymap. They used to
    be found by switching a keyboard through every layout and reading each name back, which
    the daemon took for choices made in the focused app, and which left that keyboard on
    the first layout while the others stayed where they were."""
    keyboards = kb.seat_keyboards()
    if not keyboards:
        return []
    return [name for name in kb.seat_names(keyboards)[1] if name]


def writable_config(interactive):
    assignments, writable = kb.load_config()
    if not writable:
        message = f"{kb.CONFIG} is unusable (see above); fix or remove it first"
        err(message)
        if interactive:
            kb.notify(f"Cannot update {kb.CONFIG}")
    return assignments, writable


def cmd_list(args):
    assignments, readable = kb.load_config()
    if not readable:
        err(f"cannot read {kb.CONFIG}")
        return 1
    if not assignments:
        print("no assignments — every app uses the default (US)")
    for app, layout in sorted(assignments.items()):
        print(f"{app:32} {layout}")
    return 0


def cmd_set(args):
    if len(args) < 2:
        return usage()
    app = kb.clean_name(args[0].strip())
    layout = kb.clean_name(" ".join(args[1:]).strip())
    if not app or not layout:
        err(f"class and layout must be printable and at most {kb.MAX_NAME} characters")
        return 2
    assignments, writable = writable_config(False)
    if not writable:
        return 1
    result = kb.assign(assignments, app, layout)
    if result == "full":
        err(f"{kb.MAX_APPS} apps already have a layout; clear one first")
        return 1
    if result == "changed":
        kb.save_config(assignments)
    print(f"{app} → {layout}")
    return 0


def cmd_clear(args):
    if len(args) < 1:
        return usage()
    app = args[0]
    assignments, writable = writable_config(False)
    if not writable:
        return 1
    if assignments.pop(app, None) is None:
        print(f"{app} had no assignment")
    else:
        kb.save_config(assignments)
        print(f"{app} → default (US)")
    return 0


def cmd_clear_ui(args):
    # Interactive counterpart to `clear`, so the Omarchy menu can offer it without the
    # caller having to know an app's window class by heart.
    assignments, writable = writable_config(True)
    if not writable:
        return 1
    if not assignments:
        kb.notify("No assignments to clear")
        return 0
    rows = [f"󰅖\t{app}\t{layout}" for app, layout in sorted(assignments.items())]
    picked = kb.menu("Clear layout for app", rows)
    if not picked:
        return 0
    app = picked.split("\t")[0].strip()
    # Re-read: the daemon may have recorded something while the menu was open.
    assignments, writable = writable_config(True)
    if writable and assignments.pop(app, None) is not None:
        kb.save_config(assignments)
        kb.notify(f"{app} back to the default")
    return 0


def cmd_ui(args):
    # Pick an app, then a layout. Assigned apps are listed first so the menu doubles as a
    # view of what is already set.
    assigned, _ = kb.load_config()
    running = kb.running_classes()
    installed = kb.installed_classes()
    apps = sorted(running | set(assigned) | set(installed), key=str.lower)
    if not apps:
        err("nothing to assign")
        return 1

    # omarchy-menu-select reads the FIRST tab-separated field as an ICON GLYPH, the second
    # as the label and the third as subtext. Passing "app\tlayout" therefore drew the app
    # name on top of the layout. Always lead with a glyph.
    rows = []
    for app in apps:
        glyph = "󰌌" if app in assigned else ("󰖯" if app in running else "󰀻")
        sub = assigned.get(app) or ("running" if app in running else installed.get(app, ""))
        rows.append(f"{glyph}\t{app}\t{sub}" if sub else f"{glyph}\t{app}")
    picked = kb.menu("Set layout for app", rows)
    if not picked:
        return 0
    app = kb.clean_name(picked.split("\t")[0].strip())
    if not app:
        return 0

    names = layout_names()
    if not names:
        err("no multi-layout keyboard found")
        return 1
    choice = kb.menu(f"Layout for {app}", [*names, DEFAULT_ROW])
    if not choice:
        return 0

    assignments, writable = writable_config(True)
    if not writable:
        return 1
    if choice == DEFAULT_ROW:
        if assignments.pop(app, None) is not None:
            kb.save_config(assignments)
        print(f"{app} → default (US)")
    elif choice in names:
        result = kb.assign(assignments, app, choice)
        if result == "full":
            err(f"{kb.MAX_APPS} apps already have a layout; clear one first")
            kb.notify(f"{kb.MAX_APPS} apps already have a layout; clear one first")
            return 1
        if result == "changed":
            kb.save_config(assignments)
        print(f"{app} → {choice}")
    return 0


COMMANDS = {
    "ui": cmd_ui,
    "list": cmd_list,
    "set": cmd_set,
    "clear": cmd_clear,
    "clear-ui": cmd_clear_ui,
    "devices": cmd_devices,
    "layouts": cmd_layouts,
    "cycle": cmd_cycle,
}

# Started by the bar widget, so they end with the shell.
WIDGET_COMMANDS = {"devices", "layouts", "cycle"}


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "ui"
    handler = COMMANDS.get(cmd)
    if handler is None:
        return usage()
    if cmd in WIDGET_COMMANDS:
        safe.die_with_parent()
    kb.exit_cleanly_on_signals()
    try:
        return handler(argv[2:])
    except (safe.UnsafeError, OSError) as e:
        err(str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
